{
  "name": "ohm",
  "version": "0.1.0",
  "description": "Build your own home on AT Protocol from the website you already have: your own PDS, one post schema shared by every site, and your own optional schemas, readable by other AT Protocol applications.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haeinej/ohm-content-layer.git"
  },
  "bin": {
    "ohm": "bin/ohm.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "feed",
    "vault",
    "service/public/vault/publish.js",
    "mcp",
    ".mcp.json",
    "mirror",
    "lexicons",
    "site",
    "skills",
    "docs",
    ".claude-plugin",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "lexicon": "node scripts/lexicon.mjs",
    "import": "node scripts/import.mjs",
    "sync": "node scripts/sync.mjs",
    "capabilities": "node scripts/capabilities.mjs --write",
    "migrate": "node scripts/migrate.mjs",
    "publish:post": "node scripts/publish.mjs",
    "identity": "node scripts/identity.mjs",
    "posts": "node scripts/posts.mjs",
    "profile": "node scripts/profile.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "test": "node --experimental-sqlite --test",
    "render": "node scripts/render.mjs",
    "home:dev": "wrangler dev --config public/home/wrangler.jsonc --ip 127.0.0.1 --port 8790 --local-upstream 127.0.0.1:8790",
    "home:check": "node --check public/home/src/worker.js && node --check public/home/public/sw.js && node --check public/home/public/sw-register.js && wrangler deploy --config public/home/wrangler.jsonc --dry-run",
    "home:deploy": "wrangler deploy --config public/home/wrangler.jsonc",
    "home:seo": "node public/home/scripts/check-seo.mjs",
    "home:joiners": "node public/home/scripts/joiners.mjs",
    "home-draft:dev": "wrangler dev --assets public/home-draft --ip 127.0.0.1 --port 8792 --compatibility-date 2026-10-30",
    "docs:dev": "wrangler dev --config public/docs/wrangler.jsonc --ip 127.0.0.1 --port 8791",
    "docs:build": "python3 public/docs/build.py",
    "docs:deploy": "wrangler deploy --config public/docs/wrangler.jsonc"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0"
  },
  "devDependencies": {
    "parse5": "^8.1.1",
    "wrangler": "^4.161.0"
  }
}
