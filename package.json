{
  "name": "ohm-content-layer",
  "version": "0.1.0",
  "description": "Build your own home on AT Protocol from the website you already have: your own PDS, and your own schemas, readable by other AT Protocol applications.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haeinej/ohm-content-layer.git"
  },
  "bin": {
    "ohm-content-layer": "bin/ohm-content-layer.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "feed",
    "mirror",
    "lexicons",
    "site",
    "skills",
    "docs",
    ".claude-plugin",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "lexicon": "node scripts/lexicon.mjs",
    "publish:post": "node scripts/publish.mjs",
    "identity": "node scripts/identity.mjs",
    "posts": "node scripts/posts.mjs",
    "profile": "node scripts/profile.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "test": "node --test",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0"
  }
}
