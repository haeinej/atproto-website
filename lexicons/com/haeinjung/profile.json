{
  "lexicon": 1,
  "id": "com.haeinjung.profile",
  "description": "Who the site's author is. Its fields are those of Bluesky's app.bsky.actor.profile, so they can be copied either way unchanged. A site adds sections Bluesky has no field for under `site`.",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "properties": {
          "displayName": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
          "description": {
            "type": "string",
            "maxGraphemes": 256,
            "maxLength": 2560,
            "description": "Free-form profile description text."
          },
          "pronouns": {
            "type": "string",
            "maxGraphemes": 20,
            "maxLength": 200,
            "description": "Free-form pronouns text."
          },
          "website": { "type": "string", "format": "uri", "description": "Deprecated: use links instead." },
          "links": {
            "type": "array",
            "maxLength": 10,
            "description": "Links shown on the profile, in display order. Each ref points to a profile link record in this repo.",
            "items": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
          },
          "avatar": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg"],
            "maxSize": 1000000,
            "description": "Small image shown beside the author's name."
          },
          "banner": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg"],
            "maxSize": 1000000,
            "description": "Larger horizontal image shown behind the profile."
          },
          "labels": {
            "type": "union",
            "refs": ["com.atproto.label.defs#selfLabels"],
            "description": "Self-label values on the overall account."
          },
          "joinedViaStarterPack": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "pinnedPost": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "createdAt": { "type": "string", "format": "datetime" },
          "site": {
            "type": "unknown",
            "description": "Optional sections only this site uses, which Bluesky has no field for. An object whose $type names the site's own optional schema. Not copied to a Bluesky profile."
          }
        }
      }
    }
  }
}
