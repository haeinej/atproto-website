{
  "lexicon": 1,
  "id": "com.haeinjung.post",
  "description": "A platform-independent post with a Markdown body, optional media, and optional source information.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "body",
          "publishedAt",
          "canonicalUrl"
        ],
        "properties": {
          "title": { "type": "string" },
          "body": {
            "type": "string",
            "maxLength": 262144,
            "description": "CommonMark. Use media:ID as an image destination to place an attachment at that point in the body. The ID refers to an entry in this post's media array."
          },
          "summary": { "type": "string" },
          "publishedAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" },
          "canonicalUrl": {
            "type": "string",
            "format": "uri",
            "description": "The primary public URL for this post."
          },
          "form": {
            "type": "string",
            "description": "What kind of object this post is, identified from its format. A writing has a title and free-form content; a note has no title. An image, gallery, video, audio, file, or media post holds only attachments. A link, embed, quote, list, or code post holds only that.",
            "enum": ["writing", "note", "image", "gallery", "video", "audio", "file", "media", "link", "embed", "quote", "list", "code"]
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "description": "The author's name for the section of their site this post belongs to, such as Writings or Photographs. Free-form."
          },
          "sublabel": {
            "type": "string",
            "maxLength": 100,
            "description": "The author's name for a group inside the label, such as a series or an album. Free-form."
          },
          "connect": {
            "type": "array",
            "description": "What this post branches from: earlier posts or web pages. Each entry is an AT URI or an HTTP(S) URL.",
            "items": { "type": "string", "format": "uri" }
          },
          "link": {
            "type": "ref",
            "ref": "#link",
            "description": "For a link or embed post: the page it points to, as that page described itself when the post was made."
          },
          "source": {
            "type": "ref",
            "ref": "#source",
            "description": "Where this post originally appeared, if it was imported or republished."
          },
          "media": {
            "type": "array",
            "description": "Attachments keyed by IDs unique within this post. References in the body determine their placement.",
            "items": {
              "type": "union",
              "refs": [
                "#image",
                "#video",
                "#audio",
                "#file"
              ]
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "site": { "type": "string", "maxLength": 100 },
        "image": {
          "type": "blob",
          "accept": [
            "image/*"
          ],
          "description": "A copy of the page's preview image."
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "platform",
        "uri"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "description": "The identifier of the original publishing platform."
        },
        "uri": { "type": "string", "format": "uri" },
        "id": { "type": "string" },
        "author": { "type": "string" },
        "publishedAt": { "type": "string", "format": "datetime" }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "id",
        "original"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original": {
          "type": "blob",
          "accept": [
            "image/*"
          ]
        },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "credit": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "extractedText": { "type": "string" }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "id",
        "original"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original": {
          "type": "blob",
          "accept": [
            "video/*"
          ]
        },
        "poster": {
          "type": "blob",
          "accept": [
            "image/*"
          ]
        },
        "caption": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "id",
        "original"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original": {
          "type": "blob",
          "accept": [
            "application/*",
            "text/*"
          ]
        },
        "caption": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "id",
        "original"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original": {
          "type": "blob",
          "accept": [
            "audio/*"
          ]
        },
        "caption": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
