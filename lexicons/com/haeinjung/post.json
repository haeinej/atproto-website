{
  "lexicon": 1,
  "id": "com.haeinjung.post",
  "description": "A platform-independent post with a Markdown body, optional media, and optional source information.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "body",
          "publishedAt",
          "canonicalUrl"
        ],
        "properties": {
          "title": { "type": "string" },
          "body": {
            "type": "string",
            "maxLength": 262144,
            "description": "CommonMark. Use media:ID as an image destination to place an attachment at that point in the body. The ID refers to an entry in this post's media array."
          },
          "summary": { "type": "string" },
          "publishedAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" },
          "canonicalUrl": {
            "type": "string",
            "format": "uri",
            "description": "The primary public URL for this post."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source": {
            "type": "ref",
            "ref": "#source",
            "description": "Where this post originally appeared, if it was imported or republished."
          },
          "media": {
            "type": "array",
            "description": "Attachments keyed by IDs unique within this post. References in the body determine their placement.",
            "items": {
              "type": "union",
              "refs": [
                "#image",
                "#video",
                "#audio"
              ]
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "platform",
        "uri"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "description": "The identifier of the original publishing platform."
        },
        "uri": { "type": "string", "format": "uri" },
        "id": { "type": "string" },
        "author": { "type": "string" },
        "publishedAt": { "type": "string", "format": "datetime" }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "id",
        "original"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original": {
          "type": "blob",
          "accept": [
            "image/*"
          ]
        },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "credit": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "extractedText": { "type": "string" }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "id",
        "original"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original": {
          "type": "blob",
          "accept": [
            "video/*"
          ]
        },
        "poster": {
          "type": "blob",
          "accept": [
            "image/*"
          ]
        },
        "caption": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "id",
        "original"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original": {
          "type": "blob",
          "accept": [
            "audio/*"
          ]
        },
        "caption": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
