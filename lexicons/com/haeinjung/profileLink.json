{
  "lexicon": 1,
  "id": "com.haeinjung.profileLink",
  "description": "A link shown on the author's profile. Field for field the same as Bluesky's app.bsky.actor.link. The profile record's links field sets which links are shown, and in what order.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["url", "createdAt"],
        "properties": {
          "url": { "type": "string", "format": "uri", "description": "The link destination, an https URL." },
          "title": {
            "type": "string",
            "maxGraphemes": 40,
            "maxLength": 320,
            "description": "Optional label for the link. Sites can fall back to the destination's domain."
          },
          "icon": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg", "image/webp"],
            "maxSize": 100000,
            "description": "The destination site's icon."
          },
          "labels": {
            "type": "union",
            "refs": ["com.atproto.label.defs#selfLabels"],
            "description": "Self-label values for this link."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
